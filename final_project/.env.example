# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 변수는 코드가 읽기 시작할 때 여기에 추가한다.
# NH 주소는 모의 서버로 코드에 고정돼 있어 설정하지 않는다.

# 이 서버의 공개 주소. 배포는 https, 로컬 개발은 http://localhost:8000
PUBLIC_BASE_URL=
# Google 로그인(OAuth 클라이언트)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OPEN_SIGNUP=false면 아래 이메일만 로그인된다. 여러 개면 쉼표로 구분
OPEN_SIGNUP=false
ADMIN_EMAILS=
# 주문 차단 스위치. false(기본)면 preview_order·place_order·cancel_order가 없다. 한도 도구는 남는다
ORDERS_ENABLED=false
# SQLite 파일 경로. data/는 커밋하지 않는다
DB_PATH=data/nh.db
# NH 키 암호화 열쇠. 32바이트를 base64로. DB 파일과 다른 곳에 보관한다
# 만들기: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
KEY_ENCRYPTION_KEY=
# 전략 실행기 주소. 배포(compose)는 http://executor:8100, 로컬 개발은 http://127.0.0.1:8100
SANDBOX_URL=http://executor:8100
# 실행기에 말을 걸 때 쓰는 토큰. 32자 이상. MCP 서버와 실행기가 같은 값을 쓴다
# 만들기: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SANDBOX_TOKEN=
# 실행기 전용(MCP 서버는 읽지 않는다): 전략을 돌리는 컨테이너 이미지.
# 배포(compose)는 같은 이름으로 고정돼 있어 이 값을 읽지 않는다. 로컬 개발에서만 쓴다
SANDBOX_IMAGE=nh-mcp-sandbox:latest
# 배포 전용: 호스트의 docker 그룹 번호. 실행기가 docker 소켓을 쓰려면 필요하다
# 확인: stat -c %g /var/run/docker.sock
DOCKER_GID=

# NH 모의 키(개발·녹화 전용, 운영자 본인 것)
NH_DEV_DOMESTIC_APP_KEY=
NH_DEV_DOMESTIC_APP_SECRET=
NH_DEV_OVERSEAS_APP_KEY=
NH_DEV_OVERSEAS_APP_SECRET=

# 배포(deploy/compose.yaml): MCP 서버용 Cloudflare Tunnel 토큰
MCP_TUNNEL_TOKEN=
# 서버가 받는 주소. 로컬은 127.0.0.1, 컨테이너는 이미지가 0.0.0.0으로 정한다
BIND_HOST=127.0.0.1
